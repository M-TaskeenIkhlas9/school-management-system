PORT=4000
NODE_ENV=development

# Logging: trace | debug | info | warn | error (default info)
LOG_LEVEL=info

# Browser origins allowed to call the API directly (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Rate limit: failed logins per 15 min per IP
LOGIN_RATE_LIMIT=10

# School
SCHOOL_NAME=Cambridge Public School
SCHOOL_TIMEZONE=Asia/Karachi
CURRENCY=USD
# Country code used to normalise local phone numbers (03001234567 -> +923001234567)
DEFAULT_COUNTRY_CODE=92

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=school_management

# JWT — required, at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# First principal account (created only when the users table is empty).
# Required in production; in development defaults to admin@school.com / admin123.
DEFAULT_PRINCIPAL_EMAIL=admin@school.com
DEFAULT_PRINCIPAL_PASSWORD=

# ---------- AI assistant ----------
# Any OpenAI-compatible service. AI_PROVIDER presets: groq (free tier, default model openai/gpt-oss-120b),
# openai (gpt-4o-mini), ollama (local, llama3.2). Without AI_PROVIDER, GROQ_API_KEY or OPENAI_API_KEY is used.
AI_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
# Optional overrides: model, endpoint, key, and a fallback model tried if the main one fails.
# AI_MODEL=
# AI_BASE_URL=
# AI_API_KEY=
# AI_FALLBACK_MODEL=
# Limits per request (defaults shown).
# AGENT_MAX_STEPS=8
# AGENT_TIMEOUT_MS=60000
# AGENT_MAX_TOKENS=60000
# Assistant messages per user per minute.
AGENT_RATE_LIMIT=20

# ---------- Messaging ----------
# No messages to parents between these hours (school time zone); "off" to disable.
QUIET_HOURS=21-7
# Channel order when a parent's preferred channel is unavailable.
CHANNEL_ORDER=whatsapp,sms,email
# Pending actions expire after this many hours; max recipients per message.
AGENT_ACTION_TTL_HOURS=72
MESSAGE_MAX_RECIPIENTS=500
# Background delivery worker (set to off to run without it); poll interval.
JOBS_WORKER=on
JOBS_POLL_MS=3000
# Printed on fee challans and report cards. FEE_LATE_FINE is added after the due date (0 = none).
SCHOOL_ADDRESS=
SCHOOL_PHONE=
SCHOOL_BANK_DETAILS="Bank name · Account title · Account no."
FEE_LATE_FINE=0
# Automations: how often to check for due rules, and which days the school is open (0 = Sunday).
AUTOMATIONS_POLL_MS=60000
SCHOOL_DAYS=1,2,3,4,5
# Email: leave SMTP_HOST empty to SIMULATE (recorded in the outbox, not delivered).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="School Office <office@example.com>"
# Testing: deliver every email to this address instead of parents.
EMAIL_REDIRECT_TO=

# SMS: off (default, nobody is routed to SMS) | simulated (outbox only) | twilio (real).
SMS_PROVIDER=off
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a sender number (E.164) or a Messaging Service SID.
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Testing: send every SMS to this number instead of parents.
SMS_REDIRECT_TO=
# Estimated price per SMS segment (160 Latin / 70 Urdu characters), in CURRENCY; 0 hides estimates.
SMS_COST_PER_SEGMENT=0

# WhatsApp: off (default) | simulated | meta (WhatsApp Cloud API).
WHATSAPP_PROVIDER=off
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Language of your approved templates (fee_reminder, absence_alert) in WhatsApp Manager.
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_REDIRECT_TO=
WHATSAPP_COST_PER_MESSAGE=0

# Delivery receipts and STOP replies. PUBLIC_BASE_URL is how providers reach this API
# (e.g. https://api.myschool.pk). Twilio: set the status/inbound URLs to
# {PUBLIC_BASE_URL}/webhooks/twilio/status and /webhooks/twilio/inbound.
# Meta: callback {PUBLIC_BASE_URL}/webhooks/whatsapp with WHATSAPP_VERIFY_TOKEN; WHATSAPP_APP_SECRET checks signatures.
PUBLIC_BASE_URL=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WEBHOOK_RATE_LIMIT=600
