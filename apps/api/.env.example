PORT=4000
NODE_ENV=development

# Logging: trace | debug | info | warn | error (default info)
LOG_LEVEL=info

# Browser origins allowed to call the API directly (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Rate limits: failed logins per 15 min per IP; assistant messages per minute per user
LOGIN_RATE_LIMIT=10
AGENT_RATE_LIMIT=20

# School
SCHOOL_NAME=Cambridge Public School
SCHOOL_TIMEZONE=Asia/Karachi
CURRENCY=USD

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=school_management

# JWT — required, at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# First principal account (created only when the users table is empty).
# Required in production; in development defaults to admin@school.com / admin123.
DEFAULT_PRINCIPAL_EMAIL=admin@school.com
DEFAULT_PRINCIPAL_PASSWORD=

# ---------- AI assistant ----------
# Provider is auto-detected: USE_OLLAMA=true → ollama, else GROQ_API_KEY → groq, else OPENAI_API_KEY → openai.
# Without any, the assistant answers a fixed set of requests (rule-based).
GROQ_API_KEY=
OPENAI_API_KEY=
USE_OLLAMA=false
# Optional overrides:
# AGENT_PROVIDER=groq
# AGENT_MODEL=openai/gpt-oss-120b

# ---------- Email (used by approved assistant actions) ----------
# Leave SMTP_HOST empty to SIMULATE: emails are recorded in the outbox but not delivered.
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASSWORD=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="School Office <office@example.com>"
# Testing: send EVERY email to this address instead of real parents.
EMAIL_REDIRECT_TO=
