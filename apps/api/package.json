{
  "name": "school-management-server",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "test:db": "DB_NAME=school_management_test node src/db/migrate.js",
    "test": "npm run test:db && NODE_ENV=test DB_NAME=school_management_test NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "seed": "node src/db/seed.js",
    "eval": "node evals/run.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.12.0",
    "nodemailer": "^6.10.1",
    "openai": "^6.25.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.2.2"
  },
  "main": "src/server.js"
}
